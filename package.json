{
  "name": "@oxog/pigment",
  "version": "1.0.1",
  "description": "Terminal styling with micro-kernel plugin architecture, Chalk compatibility, and full @oxog ecosystem integration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.mjs",
      "require": "./dist/plugins.js",
      "default": "./dist/plugins.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint --ext .ts,.tsx",
    "lint:fix": "eslint --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chalk",
    "colors",
    "terminal",
    "console",
    "ansi",
    "styling",
    "cli",
    "zero-dependency",
    "typescript",
    "plugin",
    "micro-kernel",
    "oxog"
  ],
  "author": "Ersin Koç",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ersinkoc/pigment"
  },
  "homepage": "https://pigment.oxog.dev",
  "bugs": {
    "url": "https://github.com/ersinkoc/pigment/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@oxog/plugin": "^1.0.0",
    "@oxog/types": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
